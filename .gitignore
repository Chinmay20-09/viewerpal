# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ / Android Studio related
*.iml
*.ipr
*.iws
.idea/

# VS Code — contains launch configuration and tasks you may wish to share,
# so this line is commented out by default.
#.vscode/

# Dart/Flutter/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
.packages
.pub-prevent-cache

# Freebuff local state
.freebuff/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Common build outputs
*.apk
*.aab
*.ipa

# ===================== Android =====================
# Gradle
android/**/gradle-wrapper.jar
android/.gradle/
android/captures/
android/gradlew
android/gradlew.bat
android/local.properties

# Flutter-generated plugin registrant (regenerated by `flutter pub get`)
android/**/GeneratedPluginRegistrant.java
android/**/.cxx/

# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
android/**/key.properties
**/*.keystore
**/*.jks

# ===================== iOS =====================
ios/**/dgph
ios/**/*.mode1v3
ios/**/*.mode2v3
ios/**/*.moved-aside
ios/**/*.pbxuser
ios/**/*.perspectivev3
ios/**/*sync/
ios/**/.sconsign.dblite
ios/**/.tags*
ios/**/.vagrant/
ios/**/DerivedData/
ios/**/Icon?
ios/**/Pods/
ios/**/.symlinks/
ios/**/profile
ios/**/xcuserdata
ios/**/.generated/
ios/Flutter/App.framework
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/ephemeral/
ios/Flutter/app.flx
ios/Flutter/app.zip
ios/Flutter/flutter_assets/
ios/Flutter/flutter_export_environment.sh
ios/**/ServiceDefinitions.json
ios/Runner/GeneratedPluginRegistrant.*

# Exceptions to above rules.
!ios/**/default.mode1v3
!ios/**/default.mode2v3
!ios/**/default.pbxuser
!ios/**/default.perspectivev3

# ===================== macOS =====================
# Flutter-related
macos/**/Flutter/ephemeral/
macos/**/Pods/
macos/Flutter/GeneratedPluginRegistrant.swift

# Xcode-related
macos/**/dgph
macos/**/xcuserdata/

# ===================== Linux =====================
linux/flutter/ephemeral

# Flutter-generated plugin registrant (regenerated by `flutter pub get`)
linux/flutter/generated_plugin_registrant.*

# ===================== Windows =====================
windows/flutter/ephemeral/

# Flutter-generated plugin registrant (regenerated by `flutter pub get`)
windows/flutter/generated_plugin_registrant.*

# Visual Studio user-specific files.
windows/**/*.suo
windows/**/*.user
windows/**/*.userosscache
windows/**/*.sln.docstates

# Visual Studio build-related files.
windows/**/x64/
windows/**/x86/

# Visual Studio cache files
# files ending in .cache can be ignored
windows/**/*.[Cc]ache
# but keep track of directories ending in .cache
!windows/**/*.[Cc]ache/
